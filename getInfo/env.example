# Copy to getInfo/firecrawl/.env (do not commit). start-firecrawl.ps1 generates this.
# Official baseline: Firecrawl v2.11.162, API auth off, PostgreSQL queue.

USE_DB_AUTHENTICATION=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-at-least-32-random-characters
POSTGRES_DB=postgres
PORT=3002
INTERNAL_PORT=3002
LOGGING_LEVEL=info
NUM_WORKERS_PER_QUEUE=1
MAX_CONCURRENT_JOBS=1
BROWSER_POOL_SIZE=1
HARNESS_STARTUP_TIMEOUT_MS=180000

# Optional: LLM extract / JSON mode (not required for scrape/crawl/map)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# MODEL_NAME=

# Optional: HTTP(S) proxy for outbound scrapes from containers
# PROXY_SERVER=http://host.docker.internal:7897
