# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Secrets — never commit
.env
.env.*
*.pem
credentials.json

# Headroom runtime (per-project memory DB is local)
.headroom/*.db
.headroom/logs/

# Graphify build output (regenerate with graphify extract/update)
graphify-out/

# agentmemory: local store only — do not publish personal memories
data/state_store.db/
data/temp/
data/stream_store/

# getInfo: upstream checkouts + runtime env (clone via start scripts)
getInfo/firecrawl/
getInfo/TrendRadar/
getInfo/scrapling/.venv/
getInfo/**/.env
getInfo/logs/

# System Informer portable binary (scripts/install-systeminformer.ps1)
tools/systeminformer/amd64/
tools/systeminformer/i386/
tools/systeminformer/arm64/
tools/systeminformer/*.zip
tools/systeminformer/install-state.json

# Firecrawl self-host checkout (cloned by getInfo/scripts/start-firecrawl.ps1)
getInfo/firecrawl/
# TrendRadar checkout (cloned by getInfo/scripts/start-trendradar.ps1)
getInfo/TrendRadar/
# agents-radar: optional full checkout + fetched digest cache
getInfo/agents-radar/upstream/
getInfo/agents-radar/cache/
getInfo/agents-radar/digests/
